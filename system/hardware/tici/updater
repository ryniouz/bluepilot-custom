#!/usr/bin/env bash

DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" >/dev/null && pwd )"

AGNOS_PY=$1
MANIFEST=$2

if [[ ! -f "$AGNOS_PY" || ! -f "$MANIFEST" ]]; then
  echo "invalid args"
  exit 1
fi

# Custom: Console update screen (logo, squared progress bar); stock updater_magic if it can't start here
if [ -x "$DIR/updater_console" ] && timeout 60 "$DIR/updater_console" --check > /dev/null 2>&1; then
  $DIR/updater_console $AGNOS_PY $MANIFEST
  exit $?
fi
# End Custom

if systemctl is-active --quiet weston-ready; then
  $DIR/updater_weston $AGNOS_PY $MANIFEST
else
  $DIR/updater_magic $AGNOS_PY $MANIFEST
fi
